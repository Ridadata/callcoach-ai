# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Gemini API key from https://aistudio.google.com/apikey (server-side only).
GEMINI_API_KEY=

# A current Gemini Flash model id (see https://ai.google.dev/gemini-api/docs/models).
# gemini-3.5-flash-lite answers in about 1 s.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Apps Script web app URL. Logging to Google Sheets is skipped if empty.
APPS_SCRIPT_WEBHOOK_URL=

# Must match the SECRET script property of the Apps Script project.
APPS_SCRIPT_SECRET=
